{
  "name": "dsh-roundtable-harness",
  "version": "0.3.11",
  "description": "多模型圆桌辩论插件：让 DSH 里已配置的多个 AI 带着各自人设围绕同一话题多轮互喷，共享上下文，裁判按六维（攻击性/逻辑/人设还原度/趣味度/策略/深度）加权打分，性价比另用 dsh-cost-meter 真实账本单列，输出 Markdown 战报与 docx。Multi-model roundtable debate plugin for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets"
  ],
  "license": "MIT",
  "author": "HSM266",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HSM266/dsh-roundtable-harness.git"
  },
  "homepage": "https://github.com/HSM266/dsh-roundtable-harness#readme",
  "bugs": {
    "url": "https://github.com/HSM266/dsh-roundtable-harness/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "client-plugin",
    "roundtable",
    "multi-model",
    "debate",
    "persona",
    "docx",
    "cost-meter",
    "圆桌",
    "多模型"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/verify.mjs"
  },
  "dependencies": {
    "docx": "^9.5.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
